# PolyAxis Phase 1 — environment reference (§8.5 / §13.5)
#
# Variables are read from backend/.env (copy backend/.env.example) and, for the dev-server proxy only,
# from the shell / frontend/.env. This root file documents every setting in one place.

# ---- Backend (backend/.env) -------------------------------------------------------------------
PORT=4000                                   # API port
NODE_ENV=development                        # development | production | test
FRONTEND_ORIGIN=http://localhost:5173       # the ONLY origin allowed by CORS (on Render defaults to RENDER_EXTERNAL_URL)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters   # required — the server will not start without it
SESSION_TIMEOUT_SECONDS=3600                # inactivity timeout (AUTH-06)
SESSION_REFRESH_AFTER_SECONDS=300           # how often an active session's token is renewed
DATA_DIR=./data                             # location of the JSON data files
# Passwords applied when the demo data is FIRST seeded (npm start seeds automatically if DATA_DIR is empty).
# Set both on any public deployment — the defaults are published in docs/DemoOperationGuide.md.
# SEED_ADMIN_PASSWORD=choose-a-strong-password
# SEED_DEMO_PASSWORD=choose-a-demo-password
# DEFAULT_SCORING_WEIGHTS={"informationGain":0.30,"feasibility":0.25,"uncertaintyReduction":0.20,"regulatory":0.15,"cost":0.10}

# ---- Frontend (frontend/.env) -----------------------------------------------------------------
VITE_API_BASE_URL=                          # leave empty in development — the Vite proxy forwards /api
# API_PROXY_TARGET=http://localhost:4000    # shell variable: point the Vite dev proxy at a different API port
