# PolyAxis Phase 1 Prototype — Backend environment configuration
# Copy this file to `.env` and fill in real values before running the server.
# (A combined reference for the whole project lives in the repository-root .env.example.)

# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed by CORS (8.4)
FRONTEND_ORIGIN=http://localhost:5173

# Authentication (8.4) — use a long, random, unique value in any real deployment
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Inactivity timeout (AUTH-06). A session stays alive while the user is active: each request older than
# SESSION_REFRESH_AFTER_SECONDS is answered with a fresh token.
SESSION_TIMEOUT_SECONDS=3600
SESSION_REFRESH_AFTER_SECONDS=300

# Data layer (JSON file storage — Phase 1)
DATA_DIR=./data

# Optimisation engine defaults (8.5). The live weights are editable in Admin Panel → Scoring Weights and stored in
# data/scoring.json; this JSON (must sum to 1) is only the fallback used when no scoring.json exists.
# DEFAULT_SCORING_WEIGHTS={"informationGain":0.30,"feasibility":0.25,"uncertaintyReduction":0.20,"regulatory":0.15,"cost":0.10}
